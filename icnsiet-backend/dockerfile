# Use a specific, lightweight version of Node.js on Alpine Linux for a smaller image
FROM node:18.20.2-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package files first to leverage Docker's build cache.
# This step only re-runs if your dependencies change.
COPY package*.json ./

# Install all dependencies using 'npm ci' for faster, reliable builds from package-lock.json
RUN npm ci

# Copy the rest of your application source code into the container
COPY . .

# Expose the port your application is running on (e.g., 3000)
EXPOSE 3000

# The command to start your application using the dev script
CMD [ "npm", "run", "dev" ]
